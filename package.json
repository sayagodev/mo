{
  "name": "@sayagodev/mo",
  "version": "0.8.0",
  "type": "module",
  "license": "MIT",
  "author": "sayagodev",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/sayagodev/mo",
  "description": "Mo (墨) — neutral, semantic HTML/CSS/JS UI library with a shadcn/ui-inspired design token system. Zero dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayagodev/mo.git"
  },
  "keywords": [
    "ui",
    "components",
    "component-library",
    "css",
    "design-system",
    "shadcn"
  ],
  "files": [
    "mo.min.css",
    "mo.css",
    "mo.variables.css",
    "mo.min.js",
    "mo.js",
    "mo.esm.js",
    "mo.esm.min.js",
    "mo.d.ts",
    "mo.jsx.d.ts",
    "mo.html-data.json",
    "vscode.css-custom-data.json",
    "custom-elements.json",
    "css",
    "js",
    "bin",
    "registry.json",
    "README.md",
    "LICENSE"
  ],
  "types": "mo.d.ts",
  "main": "mo.min.js",
  "module": "mo.esm.js",
  "style": "mo.min.css",
  "unpkg": "mo.min.js",
  "jsdelivr": "mo.min.js",
  "bin": {
    "mo": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./mo.d.ts",
      "import": "./mo.esm.js",
      "require": "./mo.min.js",
      "style": "./mo.min.css"
    },
    "./css": "./mo.css",
    "./css/*": "./css/*",
    "./variables.css": "./mo.variables.css",
    "./js": "./mo.js",
    "./js/*": "./js/*",
    "./registry.json": "./registry.json"
  },
  "sideEffects": [
    "*.css",
    "./mo.css",
    "./mo.min.css",
    "./mo.js",
    "./mo.min.js",
    "./src/js/*.js",
    "./js/*.js"
  ],
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "cac": "^6.7.14",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@types/react": "^19.2.18",
    "@wc-toolkit/jsx-types": "^1.7.1",
    "custom-element-vs-code-integration": "^1.5.0",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "semantic-release": "^25.0.5",
    "typescript": "^5.9.3"
  },
  "customElements": "custom-elements.json",
  "scripts": {
    "build": "make dist",
    "test": "pnpm --dir tests test"
  }
}
